root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# WordPress core convention: tabs for indentation, spaces for alignment.
[*.php]
indent_style = tab
indent_size = 4

[*.{css,scss}]
indent_style = tab
indent_size = 4

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false   # Two trailing spaces = hard line break.

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,txt}]
indent_style = space
indent_size = 2
